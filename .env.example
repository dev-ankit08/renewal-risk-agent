# Copy to .env and fill in. Never commit .env. YAML config refers to these as ${ENV:NAME}.

# Anthropic (model calls)
ANTHROPIC_API_KEY=sk-ant-...
# Set only after confirming a Zero Data Retention agreement covers your Anthropic org:
# RENEWAL_AGENT_ZDR_CONFIRMED=true

# Where the config lives (default ./config)
# RENEWAL_RISK_CONFIG_DIR=./config

# Source credentials — names are whatever your connectors.yaml references
# STRIPE_API_KEY=rk_live_...
# ZENDESK_API_TOKEN=...
# HUBSPOT_TOKEN=pat-...
# USAGE_DB_DSN=postgresql+psycopg://reader:...@db:5432/analytics
# RENEWAL_AGENT_SF_ORG_ALIAS=renewalRiskSandbox

# Slack (slack.yaml)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# REST API keys (access.yaml api_keys)
# RISK_API_KEY=...

# Local single-user only: act as this access.yaml user without an API key
# RENEWAL_RISK_DEV_USER=admin@example.com
